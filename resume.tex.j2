% Bold my name in bibliographies (CORRECTED, ROBUST VERSION)
\newcommand{\makeauthorbold}[1]{%
  \DeclareNameFormat{author}{%
    % --- 1. Print the name (bold or normal) ---
    % This part checks if the family name is the one we want to bold.
    \expandafter\ifstrequal\expandafter{\namepartfamily}{#1}
      {\mkbibbold{\namepartfamily\addcomma\addspace\namepartgiveni}} % BOLD
      {\namepartfamily\addcomma\addspace\namepartgiveni} % NORMAL
    %
    % --- 2. Add correct punctuation OR "et al." ---
    % This logic was missing from your original command.
    %
    % Check if this is the last name to be printed (respects minnames)
    \ifthenelse{\value{listcount} < \value{liststop}}
      {\addcomma\space} % NOT the last name, so just add a comma
      {%
        % This IS the last name to be printed.
        % Now, check if the list was truncated (i.e., if there are more names)
        \ifmorenames
          {\addcomma\space\bibstring{andothers}} % If so, add "et al."
          {} % Otherwise, do nothing. The style will add the final period.
      }%
  }
}
